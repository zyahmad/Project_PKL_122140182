# ======================================================
# GITIGNORE - SISTEM PEMBUAT SURAT REKOMENDASI
# Melindungi kredensial, database lokal, berkas surat, & rahasia
# ======================================================

# 1. Dependensi Node.js
node_modules/
frontend/node_modules/
backend/node_modules/

# 2. Berkas Build & Kompilasi Frontend
dist/
frontend/dist/
build/
.cache/

# 3. Environment Variables & Rahasia Sistem (.env)
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
**/.env
**/.env.*

# 4. Kredensial Google Drive, OAuth, & Kunci API
*service-account*.json
**/*service-account*.json
*oauth*.json
**/*oauth*.json
*drive-config*.json
**/*drive-config*.json
token.json
**/token.json
credentials.json
**/credentials.json
client_secret*.json
*.pem
*.key
*.pfx
*.p12

# 5. Database Lokal & Data Pengguna (Hash Password & Riwayat Surat)
backend/data/*.json
data/*.json
*.sqlite
*.sqlite3
*.db
!backend/data/.gitkeep

# 6. Berkas Surat yang Digenerate (PDF & DOCX Hasil TTD)
backend/output/*
output/*
!backend/output/.gitkeep
*.vbs

# 7. Berkas Sementara & File Kunci Microsoft Office / Word
~$*.docx
~$*.doc
*.tmp
*.temp

# 8. Berkas Log Sistem & Debugger
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 9. Pengaturan Editor & Sistem Operasi
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
